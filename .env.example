# --- Stripe ---------------------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
# Use your TEST secret key (sk_test_...) while developing.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# --- Site -----------------------------------------------------------------
# Public base URL of the deployed site (used for Stripe success/cancel links).
# In local dev this is optional; the API falls back to the request origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
